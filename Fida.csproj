<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <DisableMonoGameContentPipeline>false</DisableMonoGameContentPipeline>
    <DefaultItemExcludes>$(DefaultItemExcludes);Fida.Core\**;Fida.Android\**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Fida.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Agent\OnnxInference.cs" />
    <ProjectReference Include="Fida.Core\Fida.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Fida.Core\**" />
    <Compile Remove="Fida.Android\**\*.cs" />
    <Compile Remove="Logic\**\*.cs" />
    <Compile Remove="Campaign\**\*.cs" />
    <Compile Include="Logic\AgentPlayerController.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="onnx_models\**" />
    <EmbeddedResource Remove="onnx_models\**" />
    <None Remove="onnx_models\**" />
    <Compile Remove="Fida.Tests\**" />
    <Compile Remove="tools\**\*.cs" />
    <Compile Remove="artifacts\**" />
    <EmbeddedResource Remove="Fida.Tests\**" />
    <None Remove="Fida.Tests\**" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Fida.ico" />
    <!-- Content build outputs live under Content/bin; never publish them as loose files. -->
    <None Remove="Content\bin\**" />
    <None Remove="Content\obj\**" />
    <Content Remove="Content\bin\**" />
    <Content Remove="Content\obj\**" />
    <None Remove="FidaIcon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Fida.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="FidaIcon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1" />
    <PackageReference Include="Gum.MonoGame" Version="2026.7.22.1" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.5.1" />
    <MonoGameContentReference Include="Content\Content.mgcb" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Content\Gum\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Content\agent-settings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Content\screens\ConnectingScreen.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Content\screens\ConnectedMainMenu.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Content\screens\ConnectedOnlineMenu.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Content\screens\HostingScreen.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Content\screens\MainMenu.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Content\screens\LevelSelect.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Content\screens\OnlineLobby.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Content\screens\OnlineMenu.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Content\screens\PauseMenu.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Content\screens\SkillSelect.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Content\screens\Settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="gametext.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Content\gametext.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Content\campaign\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="server.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Content\uiconfig.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Content\scenes\DefaultScene.csv">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Content\scenes\Scene1.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Content\scenes\Scene2.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Content\scenes\Scene3.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Content\scenes\Scene4.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Target Name="RestoreDotnetTools" BeforeTargets="CollectPackageReferences" Condition="'$(SkipDotnetToolRestore)' != 'true'">
    <Message Text="Restoring dotnet tools (this might take a while depending on your internet speed and should only happen upon building your project for the first time, or after upgrading MonoGame, or clearing your nuget cache)" Importance="High" />
    <Exec Command="dotnet tool restore" />
  </Target>
</Project>
