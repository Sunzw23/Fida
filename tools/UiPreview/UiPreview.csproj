<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Fida.csproj" />
  </ItemGroup>
  <Target Name="CopyGameContentForPreview" AfterTargets="Build">
    <ItemGroup>
      <FidaPreviewContent Include="../../bin/$(Configuration)/net8.0/Content/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(FidaPreviewContent)"
          DestinationFiles="@(FidaPreviewContent->'$(TargetDir)Content/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
